+    /// <summary>
+    /// 判断解密结果是否是一段完整媒体：MPEG-TS 按 188 字节包对齐且包首同步字节正常，
+    /// 或 fMP4 以常见 box 开头。
+    /// </summary>
+    private static bool IsCompleteMedia(byte[] data)
+    {
+        if (data.Length >= 8)
+        {
+            var box = System.Text.Encoding.ASCII.GetString(data, 4, 4);
+            if (box is "ftyp" or "styp" or "moof" or "moov" or "mdat" or "sidx" or "free")
+                return true;
+        }
+
+        if (data.Length >= 188 && data.Length % 188 == 0)
+        {
+            var packets = data.Length / 188;
+            var probe = Math.Min(packets, 64);
+            for (var i = 0; i < probe; i++)
+            {
+                if (data[i * 188] != 0x47) return false;
+            }
+            if (probe < packets)
+            {
+                for (var i = packets - probe; i < packets; i++)
+                {
+                    if (data[i * 188] != 0x47) return false;
+                }
+            }
+            return true;
+        }
+
+        return false;
+    }
+}
